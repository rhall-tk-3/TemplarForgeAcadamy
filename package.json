{
  "name": "ktkc-school-programs-repository",
  "version": "1.3.0",
  "private": true,
  "description": "Production-oriented repository package for KTKC school programs with curriculum config, controllers, services, tests, public site assets, and SQL migrations.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node --test tests/api.smoke.test.js",
    "verify:deploy": "node scripts/verify-deployment.js",
    "migrate:list": "node scripts/list-migrations.js",
    "setup:prod": "sh scripts/setup-production.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "multer": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
