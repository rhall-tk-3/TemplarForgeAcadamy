{
  "name": "ktkc-school-programs-repository",
  "version": "1.3.1",
  "private": true,
  "description": "Production-oriented repository package for KTKC school programs with curriculum config, controllers, services, tests, public site assets, and SQL migrations.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node --test tests/api.smoke.test.js",
    "verify:deploy": "node scripts/verify-deployment.js",
    "migrate:list": "node scripts/list-migrations.js",
    "setup:prod": "sh scripts/setup-production.sh",
    "members:import": "node scripts/import-members-from-xlsx.mjs",
    "members:sync": "node scripts/sync-members-to-users.mjs",
    "members:sync:dry": "node scripts/sync-members-to-users.mjs --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.8",
    "puppeteer": "^24.43.1",
    "sanitize-filename": "^1.6.4",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "xlsx": "^0.18.5"
  }
}
